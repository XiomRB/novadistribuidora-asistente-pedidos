# Copie este archivo a .env y complete los valores. El archivo .env nunca se versiona ni entra en
# las imágenes: Docker Compose lo inyecta en el contenedor de la API al arrancar.

# --- OpenRouter (obligatorio) ---
# Clave propia de OpenRouter. Sin clave o sin modelo, la API arranca, pero /health informa
# interprete_no_configurado y los pedidos responden 503.
OPENROUTER_API_KEY=

# Modelo de lenguaje (identificador de OpenRouter). Debe admitir salida estructurada
# (llamada a funciones). Cobra por token según el precio vigente de OpenRouter.
LLM_MODELO=anthropic/claude-haiku-5.5

# Opcionales del intérprete (valores por defecto entre paréntesis):
# tiempo máximo por llamada en segundos (30), reintentos ante un fallo (1, máximo 2)
# y variante de instrucciones: base | catalogo (base).
LLM_TIMEOUT_S=30
LLM_REINTENTOS=1
LLM_INSTRUCCIONES=base

# --- MLflow (opcionales) ---
# Experimento de las trazas (lab3-api), contenido de las trazas (metadatos | completo; completo solo
# con un almacén local y para conjuntos públicos de evaluación; nunca D39) e intervalo de
# comprobación del servidor en segundos (10).
MLFLOW_EXPERIMENTO=lab3-api
MLFLOW_TRAZAS_CONTENIDO=metadatos
MLFLOW_INTERVALO_S=10

# --- Solo fuera de Docker ---
# Con Docker Compose estos valores los fija compose.yaml (DATA_DIR=/app/datos,
# MLFLOW_TRACKING_URI=http://mlflow:5000) y la versión es el SHA de Git de la construcción.
# Para ejecutar la API directamente con Python (python -m app.main):
# DATA_DIR=datos
# MLFLOW_TRACKING_URI=http://localhost:5000
# APP_VERSION=

# --- Opcionales de Docker Compose (valores por defecto entre paréntesis) ---
# Carpeta del equipo con los cinco archivos .parquet (./datos), puertos publicados de la API (8000)
# y de MLflow (5000, solo en 127.0.0.1).
# DATOS_HOST=./datos
# API_PUERTO=8000
# MLFLOW_PUERTO=5000

# --- Privacidad ---
# LangChain no debe enviar trazas a servicios externos.
LANGSMITH_TRACING=false
