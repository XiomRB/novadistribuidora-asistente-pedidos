# Copie este archivo a .env y complete los valores. El archivo .env nunca se versiona.

# --- OpenRouter ---
# Clave propia de OpenRouter (obligatoria para interpretar pedidos).
OPENROUTER_API_KEY=

# Modelos de lenguaje (identificadores de OpenRouter).
# Los valores siguientes son MODELOS CANDIDATOS DE EVALUACIÓN, no opciones gratuitas:
# tienen costo por token y están sujetos a disponibilidad, precio vigente y a la
# verificación de salida estructurada en la etapa E3.
# Puede configurarse cualquier otro modelo compatible con salida estructurada
# (incluido uno gratuito para desarrollo), siempre que supere las pruebas de E3.
LLM_MODELO=anthropic/claude-haiku-5.5
LLM_MODELO_RESPALDO=google/gemini-3.1-flash-lite

# --- Datos ---
# Carpeta con los archivos .parquet dentro del contenedor (se monta desde ./datos).
DATA_DIR=/app/datos

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Privacidad ---
# LangChain no debe enviar trazas a servicios externos.
LANGSMITH_TRACING=false
