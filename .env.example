# Copie este archivo a .env y complete los valores. El archivo .env nunca se versiona.

# --- OpenRouter ---
# Clave propia de OpenRouter (obligatoria para interpretar pedidos).
OPENROUTER_API_KEY=

# Modelo de lenguaje (identificador de OpenRouter). Debe admitir salida estructurada
# (llamada a funciones). Cobra por token según el precio vigente de OpenRouter.
LLM_MODELO=anthropic/claude-haiku-5.5

# Opcionales del intérprete (valores por defecto entre paréntesis):
# tiempo máximo por llamada en segundos (30), reintentos ante un fallo (1, máximo 2)
# y variante de instrucciones: base | catalogo (base).
LLM_TIMEOUT_S=30
LLM_REINTENTOS=1
LLM_INSTRUCCIONES=base

# --- Datos ---
# Carpeta con los archivos .parquet dentro del contenedor (se monta desde ./datos).
DATA_DIR=/app/datos

# --- MLflow ---
# Servidor de trazas y evaluaciones. Sin esta variable, /health informa mlflow_no_configurado.
# Si el servidor no responde, la API sigue atendiendo pedidos y /health informa mlflow_no_disponible.
MLFLOW_TRACKING_URI=http://mlflow:5000
# Opcionales: experimento de las trazas (lab3-api), contenido de las trazas (metadatos | completo;
# completo solo con un almacén local y para conjuntos públicos de evaluación; nunca D39),
# intervalo de comprobación del servidor en segundos (10) y versión del código para las trazas.
MLFLOW_EXPERIMENTO=lab3-api
MLFLOW_TRAZAS_CONTENIDO=metadatos
MLFLOW_INTERVALO_S=10
APP_VERSION=

# --- Privacidad ---
# LangChain no debe enviar trazas a servicios externos.
LANGSMITH_TRACING=false
